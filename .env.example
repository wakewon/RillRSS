# Copy to .env and adjust. .env is git-ignored — never commit real secrets.

# Port published on the host.
RILL_PORT=8080

# Admin / API username and the initial password (used only on first start;
# change it later in the web admin). If empty, a random password is printed
# to the container log on first start: docker compose logs rillrss
RILL_USERNAME=admin
RILL_PASSWORD=change-me-please

# Public URL as seen by your phone (used for cached image URLs).
# Leave empty to derive it from each request (Host / X-Forwarded-* headers).
RILL_BASE_URL=

# Trust X-Forwarded-For/Proto/Host from a reverse proxy.
RILL_TRUST_PROXY=true

# Allow article pages / images on private networks (LAN). Feeds themselves may
# always be on private networks.
RILL_ALLOW_PRIVATE_NETWORKS=false

# Default OpenAI-compatible translation service (can also be set in the web admin).
# Examples: https://api.openai.com/v1  https://api.deepseek.com/v1
#           https://dashscope.aliyuncs.com/compatible-mode/v1  http://ollama:11434/v1
RILL_TRANSLATE_BASE_URL=
RILL_TRANSLATE_API_KEY=
RILL_TRANSLATE_MODEL=

# Log level (error, warn, info, debug) — e.g. info,rillrss=debug
RILL_LOG=info

# Time zone for logs, and the user/group the service runs as inside the container.
TZ=Asia/Shanghai
PUID=1000
PGID=1000

# Where data (SQLite DB, image cache) is stored on the host.
RILL_DATA_PATH=./data
