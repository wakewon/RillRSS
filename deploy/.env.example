# RillRSS settings. Fill in RILL_PASSWORD and RILL_BASE_URL before starting;
# Compose refuses to start while either is empty.
RILL_USERNAME=admin
# Initial admin password, used only on first start (change it later in the web admin).
# Generate one with: openssl rand -hex 16
RILL_PASSWORD=
# Public HTTPS address of this server, e.g. https://rss.example.com
RILL_BASE_URL=
# Local port Nginx proxies to (bound to 127.0.0.1 only).
RILL_PORT=8080
RILL_TRUST_PROXY=true
RILL_ALLOW_PRIVATE_NETWORKS=false
# Optional default translation service (can also be set in the web admin).
RILL_TRANSLATE_BASE_URL=
RILL_TRANSLATE_API_KEY=
RILL_TRANSLATE_MODEL=
RILL_LOG=info
TZ=Asia/Kuala_Lumpur
PUID=1000
PGID=1000
